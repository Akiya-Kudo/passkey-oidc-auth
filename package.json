{
	"name": "passkey-oidc-auth",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm run dev:idp & pnpm run dev:interaction-ui & wait",
		"dev:idp": "tsx watch --env-file .env apps/local-server/src/server.ts",
		"dev:interaction-ui": "vite --config apps/interaction-ui/vite.config.ts",
		"build:interaction-ui": "vite build --config apps/interaction-ui/vite.config.ts",
		"cdk:synth": "pnpm build:interaction-ui && pnpm --filter @passkey-oidc-auth/cdk synth",
		"cdk:deploy": "pnpm build:interaction-ui && pnpm --filter @passkey-oidc-auth/cdk run deploy",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/interaction-ui/tsconfig.json --noEmit",
		"lint": "biome check src apps infra/cdk/lib infra/cdk/bin scripts utils biome.json",
		"format": "biome format --write src apps infra/cdk/lib infra/cdk/bin scripts utils biome.json",
		"ts:check": "tsc -p tsconfig.json --noEmit && tsc -p apps/interaction-ui/tsconfig.json --noEmit",
		"tables:local": "tsx  --env-file .env scripts/create-local-tables.ts"
	},
	"dependencies": {
		"@aws-sdk/client-dynamodb": "^3.901.0",
		"@aws-sdk/client-secrets-manager": "^3.1109.0",
		"@aws-sdk/lib-dynamodb": "^3.901.0",
		"@koa/router": "^15.7.0",
		"jose": "^6.2.8",
		"koa": "^3.2.1",
		"koa-mount": "^4.2.0",
		"oidc-provider": "^9.11.3",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"serverless-http": "^3.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"@types/aws-lambda": "^8.10.152",
		"@types/koa": "^3.0.3",
		"@types/koa-mount": "^4.0.5",
		"@types/koa__router": "^12.0.4",
		"@types/node": "^20",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@types/oidc-provider": "^9.11.1",
		"esbuild": "^0.25.9",
		"tsx": "^4.20.5",
		"typescript": "^5",
		"vite": "^7.1.12"
	},
	"packageManager": "pnpm@10.34.5"
}
