# TODO: 環境変数のprefix 整理する

LOCAL_IDP_PORT=3000
# ローカルでは Vite (4000) が公開 origin、Koa (3000) がその背後の API になる
ISSUER=http://localhost:4000

# Cookie 署名鍵（カンマ区切りでローテーション可）
# TODO: 本番は Secrets Manager / SSM から注入
COOKIE_KEYS=local-dev-cookie-key

# DynamoDB
OIDC_TABLE_NAME=passkey-oidc-local
USER_TABLE_NAME=passkey-user-local
CREDENTIAL_TABLE_NAME=passkey-credential-local

# Interaction login methods: password, passkey (comma-separated)
AUTH_METHOD=password

AWS_REGION=ap-northeast-1

# JWKS
# ローカル: 未設定のまま → プロセス内で一時鍵を生成
# デプロイ: CDK が Secrets Manager に JWKS を作り、JWKS_SECRET_ARN を Lambda へ注入
# JWKS_SECRET_ARN=

# API Gateway 背後で true
# OIDC_TRUST_PROXY=true

# ローカルのみ。設定時は SDK にダミー credentials を渡す（本番では絶対に置かない）
LOCAL_DYNAMODB_ENDPOINT=http://localhost:8000

# 静的 OIDC Client（TODO: DynamoDB 管理へ移行）
LOCAL_OIDC_CLIENT_ID=foo
LOCAL_OIDC_CLIENT_SECRET=bar
LOCAL_OIDC_REDIRECT_URIS=http://localhost:8080/cb

# Local demo user for password login (pnpm seed:local-user)
LOCAL_SEED_USER_EMAIL=demo@example.com
LOCAL_SEED_USER_PASSWORD=password
LOCAL_SEED_USER_DISPLAY_NAME=Demo User
