LOCAL_PORT=3000
ISSUER=http://localhost:3000

# Cookie 署名鍵（カンマ区切りでローテーション可）
# TODO: 本番は Secrets Manager / SSM から注入
COOKIE_KEYS=local-dev-cookie-key

# DynamoDB（未設定なら Memory Adapter）
# OIDC_TABLE_NAME=passkey-oidc-local
# DYNAMODB_ENDPOINT=http://localhost:8000
# AWS_REGION=ap-northeast-1

# 静的 OIDC Client（TODO: DynamoDB 管理へ移行）
OIDC_CLIENT_ID=foo
OIDC_CLIENT_SECRET=bar
OIDC_REDIRECT_URIS=http://localhost:8080/cb

# JWKS（未設定なら起動時に一時鍵を生成 = Lambda では不可）
# TODO: 本番は JWKS_SECRET_ARN または JWKS_JSON を設定
# JWKS_JSON=
# JWKS_SECRET_ARN=

# API Gateway 背後で true
# OIDC_TRUST_PROXY=true
